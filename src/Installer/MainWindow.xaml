<Window x:Class="BigWalkVRInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BigWalkVRInstaller"
        Title="CircuitLord's VR Mod Installer"
        Width="720" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStyle="None"
        Icon="app.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="ModCard">
            <Border Style="{StaticResource Card}" Padding="16,13">
                <Grid>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource Tag}" Padding="6,1" Margin="8,0,0,0"
                                            Background="{StaticResource AmberFill}" BorderBrush="{StaticResource AmberFillBorder}"
                                            Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="BETA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Style="{StaticResource QuietDanger}" Content="Uninstall" FontSize="11.5" Padding="6,3"
                                        Margin="0,0,8,0" Click="Uninstall_Click"
                                        Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                                <Button x:Name="Install" Style="{StaticResource Primary}" Content="{Binding InstallLabel}" Padding="18,7"
                                        Click="Install_Click" Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}" />
                                <Button x:Name="Update" Style="{StaticResource Update}" Content="{Binding UpdateLabel}" Padding="18,7"
                                        Click="Install_Click" Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}" />
                                <Border x:Name="Installed" Style="{StaticResource StatusChip}"
                                        Visibility="{Binding ShowCurrent, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                        <TextBlock Text="Installed" Foreground="{StaticResource Green}" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="Channels" Style="{StaticResource ChannelsButton}" Click="Channels_Click"
                                        Visibility="{Binding ShowChannels, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,2" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BusyText}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                            <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="21" Height="21" CornerRadius="11" Background="{StaticResource Amber}"
                            BorderBrush="{StaticResource Bg}" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                            ToolTip="{Binding UpdateLabel}"
                            Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Bg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowChannels}" Value="True">
                    <Setter TargetName="Install" Property="local:Corners.Radius" Value="6,0,0,6" />
                    <Setter TargetName="Update" Property="local:Corners.Radius" Value="6,0,0,6" />
                    <Setter TargetName="Installed" Property="CornerRadius" Value="6,0,0,6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowUpdate}" Value="True">
                    <Setter TargetName="Channels" Property="Style" Value="{StaticResource ChannelsUpdate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowCurrent}" Value="True">
                    <Setter TargetName="Channels" Property="Style" Value="{StaticResource ChannelsInstalled}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="app.ico" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="CircuitLord's VR Mod Installer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="10,1,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button Style="{StaticResource TitlebarButton}" Click="Minimize_Click"
                        AutomationProperties.Name="Minimize" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource TitlebarClose}" Click="Close_Click"
                        AutomationProperties.Name="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="SelfUpdateBanner" Grid.Row="1" Style="{StaticResource InfoPanel}" Margin="18,4,18,12"
                Padding="16,12" Background="{StaticResource AmberFill}"
                BorderBrush="{StaticResource AmberFillBorder}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="SelfUpdateTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button x:Name="SelfUpdateButton" Grid.Column="2" Style="{StaticResource Update}"
                        Content="Update now" Padding="18,7" Click="SelfUpdate_Click" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="GameSelectionView" Grid.Row="2" Margin="18,8,18,0" VerticalScrollBarVisibility="Auto">
          <Grid MinHeight="{Binding ActualHeight, ElementName=GameSelectionView}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="2,0,0,14">
                <TextBlock Text="Choose a game" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <Button x:Name="BigWalkCard" Style="{StaticResource GameCard}" Height="96" Margin="0,0,0,8"
                        Click="SelectBigWalk_Click" AutomationProperties.Name="Big Walk VR">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BigWalkArt" CornerRadius="9,0,0,9">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/big-walk.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="Big Walk VR" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="BigWalkCardStatus" Text="Checking game..." FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextDim}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border x:Name="BigWalkInstalledChip" Grid.Column="2" Style="{StaticResource StatusChip}"
                                Padding="9,4" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                <TextBlock Text="Installed" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Green}" />
                                <TextBlock x:Name="BigWalkInstalledVersion" FontSize="11.5" Foreground="{StaticResource Green}"
                                           Opacity="0.85" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </Grid>
                </Button>
                <Button x:Name="TitanfallCard" Style="{StaticResource GameCard}" Height="96" Margin="0,0,0,8"
                        Click="SelectTitanfall_Click" AutomationProperties.Name="Titanfall 2 VR">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TitanfallArt" CornerRadius="9,0,0,9">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/titanfall-2.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <Border Style="{StaticResource Tag}" Background="White" BorderBrush="White" Padding="7,2"
                                Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="NEW" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Bg}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="Titanfall 2 VR" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="TitanfallCardStatus" Text="Checking game..." FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextDim}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border x:Name="TitanfallCardInstalledChip" Grid.Column="2" Style="{StaticResource StatusChip}"
                                Padding="9,4" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                <TextBlock Text="Installed" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Green}" />
                                <TextBlock x:Name="TitanfallInstalledVersion" FontSize="11.5" Foreground="{StaticResource Green}"
                                           Opacity="0.85" Margin="5,0,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </Grid>
                </Button>
            </StackPanel>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,12">
                <TextBlock Text="Made for the love of VR by CircuitLord" FontSize="11.5" FontStyle="Italic"
                           Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" />
                <Button Style="{StaticResource SupportButton}" HorizontalAlignment="Center" Click="OpenSupport_Click" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="♥" Margin="0,0,7,0" />
                        <TextBlock Text="Support" />
                    </StackPanel>
                </Button>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Grid x:Name="InstallerView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="18,4,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource Ghost}" Content="‹  Games" Padding="12,7" Click="BackToGames_Click" />
                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="6" ClipToBounds="True" Margin="12,0,9,0">
                    <Image x:Name="SelectedGameImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedGameName" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedGameStatus" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Style="{StaticResource Ghost}" Content="Refresh" Click="Refresh_Click" />
                    <Button x:Name="LaunchNonVrButton" Style="{StaticResource Secondary}" Content="Launch in Non-VR"
                            Padding="16,7" Margin="8,0,0,0" Click="LaunchNonVr_Click" />
                    <Button x:Name="LaunchButton" Style="{StaticResource Primary}" Content="Launch in VR"
                            Padding="16,7" Margin="8,0,0,0" Click="Launch_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NavInstall" Style="{StaticResource NavPill}" Content="Setup"
                                     IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavPill}" Content="Logs" Margin="3,0,0,0"
                                     Checked="Nav_Checked" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="InstallView" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
                        <Grid Margin="0,0,10,0">
                            <StackPanel x:Name="BigWalkContent">
                                <Border Style="{StaticResource CardStatic}" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="GameBadge" Grid.Column="0" Style="{StaticResource StepBadge}">
                                            <TextBlock x:Name="GameBadgeText" Text="1" Tag="1" Style="{StaticResource StepBadgeText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Find Big Walk" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="GamePathText" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="OpenFolderButton" Style="{StaticResource Ghost}" Content="Open" Padding="14,7" Click="OpenGameFolder_Click" />
                                            <Button x:Name="ChangeFolderButton" Style="{StaticResource Ghost}" Content="Change" Padding="14,7" Margin="8,0,0,0" Click="ChangeGamePath_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStatic}" Padding="16,13">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BepInExBadge" Grid.Column="0" Style="{StaticResource StepBadge}">
                                                <TextBlock x:Name="BepInExBadgeText" Text="2" Tag="2" Style="{StaticResource StepBadgeText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="Set up BepInEx" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BepInExText" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button x:Name="BepInExButton" Grid.Column="2" Style="{StaticResource Primary}" Padding="18,7"
                                                    VerticalAlignment="Center" Click="InstallBepInEx_Click" />
                                        </Grid>
                                        <StackPanel x:Name="BepInExProgressPanel" Margin="0,12,0,2" Visibility="Collapsed">
                                            <TextBlock x:Name="BepInExProgressText" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                                            <ProgressBar x:Name="BepInExProgress" Style="{StaticResource Progress}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <Border x:Name="ModsBadge" Style="{StaticResource StepBadge}">
                                        <TextBlock x:Name="ModsBadgeText" Text="3" Tag="3" Style="{StaticResource StepBadgeText}" />
                                    </Border>
                                    <TextBlock Text="Install mods" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl x:Name="ModsList" ItemTemplate="{StaticResource ModCard}" />

                                <TextBlock x:Name="OfflineNotice" Text="Couldn't reach the download list. Check your connection and press Refresh."
                                           Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed" />

                                <StackPanel HorizontalAlignment="Center" Margin="0,22,0,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource Quiet}" Content="Discord" FontSize="11.5" Padding="6,3" Click="OpenDiscord_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button Style="{StaticResource Quiet}" Content="GitHub" FontSize="11.5" Padding="6,3" Click="OpenRepo_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button Style="{StaticResource Quiet}" Content="Mod logs" FontSize="11.5" Padding="6,3" Click="OpenModLogs_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button x:Name="CrashReportButton" Style="{StaticResource Quiet}" Content="Create crash report" FontSize="11.5" Padding="6,3" Click="CreateCrashReport_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button x:Name="RestoreVanillaButton" Style="{StaticResource QuietDanger}" Content="Restore vanilla" FontSize="11.5" Padding="6,3" Click="RestoreVanilla_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Made for the love of VR by CircuitLord" FontSize="11.5" FontStyle="Italic"
                                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,26,0,5" />
                                    <Button Style="{StaticResource SupportButton}" HorizontalAlignment="Center" Click="OpenSupport_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♥" Margin="0,0,7,0" />
                                            <TextBlock Text="Support" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="TitanfallContent" Visibility="Collapsed">
                                <Border Style="{StaticResource CardStatic}" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="TitanfallGameBadge" Grid.Column="0" Style="{StaticResource StepBadge}">
                                            <TextBlock x:Name="TitanfallGameBadgeText" Text="1" Tag="1" Style="{StaticResource StepBadgeText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Find Titanfall 2" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TitanfallGamePathText" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="TitanfallOpenFolderButton" Style="{StaticResource Ghost}" Content="Open" Padding="14,7" Click="OpenGameFolder_Click" />
                                            <Button Style="{StaticResource Ghost}" Content="Change" Padding="14,7" Margin="8,0,0,0" Click="ChangeGamePath_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStatic}" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="TitanfallEaBadge" Grid.Column="0" Style="{StaticResource StepBadge}">
                                            <TextBlock x:Name="TitanfallEaBadgeText" Text="2" Tag="2" Style="{StaticResource StepBadgeText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Sign in to EA app" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TitanfallEaText" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button x:Name="TitanfallEaButton" Grid.Column="2" Style="{StaticResource Ghost}" Padding="14,7"
                                                VerticalAlignment="Center" Click="TitanfallEa_Click" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStatic}" Padding="16,13">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="TitanfallInstallBadge" Grid.Column="0" Style="{StaticResource StepBadge}">
                                                <TextBlock x:Name="TitanfallInstallBadgeText" Text="3" Tag="3" Style="{StaticResource StepBadgeText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Titanfall 2 VR" FontSize="14" FontWeight="SemiBold" />
                                                    <Border x:Name="TitanfallBetaTag" Style="{StaticResource Tag}" Padding="6,1" Margin="8,0,0,0"
                                                            Background="{StaticResource AmberFill}" BorderBrush="{StaticResource AmberFillBorder}" Visibility="Collapsed">
                                                        <TextBlock Text="BETA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="TitanfallVersionText" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="TitanfallUninstallButton" Style="{StaticResource QuietDanger}" Content="Uninstall"
                                                        FontSize="11.5" Padding="6,3" Margin="0,0,8,0" Click="TitanfallUninstall_Click" Visibility="Collapsed" />
                                                <Button x:Name="TitanfallInstallButton" Style="{StaticResource Primary}" Content="Install" Padding="18,7"
                                                        Click="TitanfallInstall_Click" />
                                                <Border x:Name="TitanfallInstalledChip" Style="{StaticResource StatusChip}" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Green}" Margin="0,1,7,0" />
                                                        <TextBlock Text="Installed" Foreground="{StaticResource Green}" FontSize="12" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="TitanfallChannelsButton" Style="{StaticResource ChannelsButton}" Click="TitanfallChannels_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="TitanfallProgressPanel" Margin="0,12,0,2" Visibility="Collapsed">
                                            <TextBlock x:Name="TitanfallProgressText" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                                            <ProgressBar x:Name="TitanfallProgress" Style="{StaticResource Progress}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel HorizontalAlignment="Center" Margin="0,28,0,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource Quiet}" Content="Discord" FontSize="11.5" Padding="6,3" Click="OpenDiscord_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button Style="{StaticResource Quiet}" Content="GitHub" FontSize="11.5" Padding="6,3" Click="OpenRepo_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button x:Name="TitanfallCrashReportButton" Style="{StaticResource Quiet}" Content="Create crash report"
                                                FontSize="11.5" Padding="6,3" Click="CreateCrashReport_Click" />
                                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                                        <Button x:Name="TitanfallSavesButton" Style="{StaticResource Quiet}" Content="Campaign saves"
                                                FontSize="11.5" Padding="6,3" Click="TitanfallSaves_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Made for the love of VR by CircuitLord" FontSize="11.5" FontStyle="Italic"
                                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,26,0,5" />
                                    <Button Style="{StaticResource SupportButton}" HorizontalAlignment="Center" Click="OpenSupport_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="♥" Margin="0,0,7,0" />
                                            <TextBlock Text="Support" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer x:Name="LogsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <ItemsControl x:Name="LogsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- a star column bounds the message width so long errors wrap -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="{StaticResource TextDim}" FontFamily="Consolas" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="18,12,18,14">
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                       AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="2,0,10,0" />
        </Grid>

        <Border x:Name="LaunchOverlay" Grid.Row="0" Grid.RowSpan="4" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Control Grid.Column="0" Style="{StaticResource Spinner}" VerticalAlignment="Center" Margin="0,0,15,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LaunchTitle" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="LaunchDescription" FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="GenPanel" Style="{StaticResource InfoPanel}" Margin="0,16,0,0" Padding="14,12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GenCheck" Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,11,0" Visibility="Collapsed" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="GenTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="GenText" FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource Ghost}" Content="Stop" Padding="16,7" Margin="0,18,0,0"
                            HorizontalAlignment="Right" Click="LaunchStop_Click" />
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="TitanfallSavesOverlay" Grid.Row="0" Grid.RowSpan="4" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Campaign save" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Titanfall 2 VR keeps its own campaign, separate from the base game save."
                               FontSize="12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VR save" FontSize="12.5" />
                        <TextBlock x:Name="TitanfallVrSaveStatus" Grid.Column="1" FontSize="12.5" Foreground="{StaticResource TextDim}" />
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <Button x:Name="TitanfallSaveDirectoryButton" Style="{StaticResource Ghost}" Content="Open folder"
                                Padding="16,7" HorizontalAlignment="Left" Click="OpenTitanfallSaves_Click" />
                        <Button x:Name="TitanfallSavesCloseButton" Style="{StaticResource Ghost}" Content="Close" Padding="16,7"
                                HorizontalAlignment="Right" Click="CloseTitanfallSaves_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="4" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfirmText" FontSize="12.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="ConfirmCancel" Style="{StaticResource Ghost}" Content="Cancel" Padding="16,7" Click="ConfirmCancel_Click" />
                        <Button x:Name="ConfirmOk" Style="{StaticResource Danger}" Padding="16,7" Margin="8,0,0,0" Click="ConfirmOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
