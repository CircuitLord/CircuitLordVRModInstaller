<UserControl x:Class="BigWalkVRInstaller.ModStepCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BigWalkVRInstaller">
    <!-- setup step installing a game's main mod, with the release dropdown and install progress -->
    <Border Style="{StaticResource CardStatic}" Padding="16,13">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" Style="{StaticResource StepBadge}">
                    <TextBlock x:Name="BadgeText" Style="{StaticResource StepBadgeText}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" />
                        <Border x:Name="ChannelTagBorder" Style="{StaticResource Tag}" Padding="6,1" Margin="8,0,0,0"
                                Background="{StaticResource AmberFill}" BorderBrush="{StaticResource AmberFillBorder}">
                            <TextBlock x:Name="ChannelTagText" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailText" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UninstallButton" Style="{StaticResource QuietDanger}" Content="Uninstall"
                            FontSize="11.5" Padding="6,3" Margin="0,0,8,0" Click="Uninstall_Click" />
                    <local:InstallAction x:Name="Action" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ProgressPanel" Margin="0,12,0,2">
                <TextBlock x:Name="ProgressText" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                <ProgressBar x:Name="ProgressBar" Style="{StaticResource Progress}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
