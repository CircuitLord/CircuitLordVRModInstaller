                         "changes":  [
                                         {
                                             "version":  "1.0.32",
                                             "date":  "2026-11-21",
                                             "notes":  "Highlights:\n- added \"None\" turning option\n- adjusted how joystick input was calculated to fix some people who were unable to wallrun or walk at full speed\n- fixed pilot hud status messages not rendering in VR\n- converted more cutscenes into VR, one with full VR interactions"
                                         },
                                         {
                                             "version":  "1.0.29",
                                             "date":  "2026-11-17",
                                             "notes":  "Stable full release of all the beta features!\n\nHighlights:\n- Steam Frame support! Finger tracking + updated tutorials\n- Configurable laser sights!\n- Magazine physics! Grab, throw, and knock them out of guns!\n- Gun trigger animations and improved hand poses"
                                         },
                                         {
                                             "version":  "1.0.25",
                                             "date":  "2026-10-24",
                                             "notes":  "Changes:\n- added support for ticks and satchels\n- fixed offset when two-handing archer, thunderbolt, or arc gun\n- fixed Ronin sword core preventing ability use\n- fixed grab pose for EPG mag"
                                         },
                                         {
                                             "version":  "1.0.24",
                                             "date":  "2026-10-23",
                                             "notes":  "The biggest update for TF2VR by far!\n\nHighlights:\n- Brand new head-based Titan control scheme\n- Improved and standardized mag grab poses on all guns\n- \"Shimmer Reduction\" graphics setting, massively reduces jagged edges for very little perf cost!\n- Tons of other polish and bug-fixes!\n\nJoin the Discord to see the full changelog!"
                                         }
